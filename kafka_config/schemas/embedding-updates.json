{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudySphere Embedding Updates",
  "type": "object",
  "properties": {
    "eventId": { "type": "string" },
    "eventType": {
      "type": "string",
      "enum": ["EMBEDDING_UPDATED"]
    },
    "aggregateId": { "type": "string" },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "embeddingType": {
          "type": "string",
          "enum": ["user", "post"]
        },
        "updatedAt": { "type": "string" },
        "priority": { "type": "string" },
        "sourceEventId": {
          "type": ["string", "null"]
        }
      },
      "required": ["embeddingType", "updatedAt"]
    }
  },
  "required": ["eventId", "eventType", "aggregateId", "timestamp", "version", "data"]
}
