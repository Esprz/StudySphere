{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudySphere User Events",
  "type": "object",
  "properties": {
    "eventId": { "type": "string" },
    "eventType": {
      "type": "string",
      "enum": [
        "USER_CREATED",
        "USER_UPDATED",
        "USER_DELETED",
        "USER_FOLLOWED",
        "USER_UNFOLLOWED",
        "USER_LOGIN",
        "USER_LOGOUT"
      ]
    },
    "aggregateId": { "type": "string" },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version": { "type": "string" },
    "metadata": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "environment": { "type": "string" },
        "experimentBucket": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "followeeId": { "type": "string" },
        "followedAt": { "type": "string" },
        "unfollowedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "required": ["eventId", "eventType", "aggregateId", "timestamp", "version", "data"],
  "allOf": [
    {
      "if": {
        "properties": { "eventType": { "enum": ["USER_FOLLOWED", "USER_UNFOLLOWED"] } }
      },
      "then": {
        "properties": {
          "data": {
            "required": ["followeeId"]
          }
        }
      }
    }
  ]
}
